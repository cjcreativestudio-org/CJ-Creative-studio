# CJ Studio — environment variables (copy to .env.local for local dev; set the
# real values in the Vercel project settings for production).

# Contact form email delivery (Resend). Without it the /contact form is inert.
RESEND_API_KEY=

# Outreach engine — Cal.com booking link for the /demo/[slug] "book a call" CTA
# (Brick 7). Set this to your Cal.com handle/event slug, e.g. "cjstudio/intro-20min"
# (a full "https://cal.com/cjstudio/intro-20min" URL is accepted too). Because it
# is NEXT_PUBLIC_*, it is inlined at build time — after changing it, redeploy.
# When UNSET, the CTA gracefully falls back to a pre-addressed mailto, so the live
# /demo page never renders a broken/empty booking widget. It auto-arms the Cal.com
# in-page popup the moment this is present — no code change needed to go live.
NEXT_PUBLIC_CALCOM_LINK=
